# --- Required -------------------------------------------------------------
GROQ_API_KEY=gsk_your_key_here
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- Models ---------------------------------------------------------------
PLANNER_MODEL=openai/gpt-oss-120b
GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
PROMPT_GUARD_THRESHOLD=0.5

# --- Policy bounds (integer paise; 100 paise = 1 INR) ---------------------
SESSION_SPEND_CAP_PAISE=250000
MANDATE_VALIDITY_SECONDS=300

# --- Debug only: enables /api/v1/simulate/execute and chaos flags ---------
ALLOW_MOCK_GATEWAY=false
