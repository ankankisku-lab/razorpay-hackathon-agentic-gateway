# Virtual Environment (the culprit containing the 290MB torch dll)
razorpay-hackathon/
venv/
.venv/
env/

# Python byte code and caches
__pycache__/
*.py[cod]
*$py.class

# Pytest cache
.pytest_cache/

# Environment variables & secrets (API keys)
.env
.env.*
!.env.example

# FAISS / local vector index files (if generated locally)
*.index
*.faiss

# Cryptographic Private Keys
backend/keys/*.pem
!backend/keys/*.pub.pem
*.pem
*.key


# Ledger runtime state (active log, rotation checkpoint, archived segments)
backend/ledger.jsonl
backend/ledger.checkpoint.json
backend/ledger_archive/
retrieval/catalog_meta.json

# Local interview prep notes
interview-prep/
